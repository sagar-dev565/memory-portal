---
// Pinned section: a 3D VHS cassette rotates while the "decay" statements reveal,
// then the tape is "restored" — colour and signal come back.
---

<section class="problem" data-problem>
  <div class="problem__pin" data-problem-pin>
    <div class="container problem__grid">
      <div class="problem__copy">
        <p class="eyebrow">Why now</p>
        <div class="problem__lines">
          <h2 class="title problem__line" data-problem-line>Tapes fade.</h2>
          <h2 class="title problem__line" data-problem-line>Discs fail.</h2>
          <h2 class="title problem__line" data-problem-line>Photos curl.</h2>
          <h2 class="title problem__line problem__line--gold" data-problem-line><em>We bring them back.</em></h2>
        </div>
        <p class="lead problem__lead" data-problem-lead>
          Most families keep decades of memories on formats that are slowly breaking down —
          and on players nobody owns anymore. Every year they wait, a little more is lost.
        </p>
      </div>

      <div class="stage" aria-hidden="true">
        <div class="tape-wrap" data-tape-wrap>
        <div class="tape3d" data-tape>
          <div class="tape3d__face tape3d__front">
            <div class="tape3d__label">
              <span>Our Wedding</span>
              <small>12 · 12 · 1998 — Tape 1 of 3</small>
            </div>
            <div class="tape3d__window">
              <span class="tape3d__reel" data-reel></span>
              <span class="tape3d__reel" data-reel></span>
            </div>
          </div>
          <div class="tape3d__face tape3d__back"></div>
          <div class="tape3d__face tape3d__top"></div>
          <div class="tape3d__face tape3d__bottom"></div>
          <div class="tape3d__face tape3d__left"></div>
          <div class="tape3d__face tape3d__right"></div>
        </div>
        </div>
        <div class="stage__noise" data-tape-noise></div>
        <div class="stage__glow" data-tape-glow></div>
        <p class="stage__status"><span data-tape-status>Signal: degrading</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .problem {
    position: relative;
    background: var(--mp-night);
  }
  .problem__pin {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-block: 6rem;
  }
  .problem__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .problem__lines {
    margin-top: 1.5rem;
  }
  .problem__line {
    color: var(--mp-night-text);
  }
  .problem__lead {
    margin-top: 2rem;
  }
  .stage {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 32px;
    background: radial-gradient(60% 60% at 50% 50%, #241e18, var(--mp-night-2));
    border: 1px solid var(--mp-night-line);
    overflow: hidden;
  }
  .tape-wrap {
    perspective: 1200px;
    filter: grayscale(0.9) contrast(0.85) brightness(0.8);
  }
  .tape3d {
    --w: clamp(220px, 28vw, 380px);
    --h: calc(var(--w) * 0.56);
    --d: calc(var(--w) * 0.12);
    position: relative;
    width: var(--w);
    height: var(--h);
    transform-style: preserve-3d;
    transform: rotateX(18deg) rotateY(-28deg);
  }
  .tape3d__face {
    position: absolute;
    background: #1b1815;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .tape3d__front,
  .tape3d__back {
    inset: 0;
    border-radius: 10px;
  }
  .tape3d__front {
    transform: translateZ(calc(var(--d) / 2));
    background: linear-gradient(160deg, #2a2520, #15120f);
    padding: 7% 8%;
    display: flex;
    flex-direction: column;
    gap: 8%;
  }
  .tape3d__back {
    transform: rotateY(180deg) translateZ(calc(var(--d) / 2));
  }
  .tape3d__top,
  .tape3d__bottom {
    left: 0;
    right: 0;
    height: var(--d);
    top: 50%;
    margin-top: calc(var(--d) / -2);
    background: #120f0d;
  }
  .tape3d__top {
    transform: rotateX(90deg) translateZ(calc(var(--h) / 2));
  }
  .tape3d__bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--h) / 2));
  }
  .tape3d__left,
  .tape3d__right {
    top: 0;
    bottom: 0;
    width: var(--d);
    left: 50%;
    margin-left: calc(var(--d) / -2);
    background: #100d0b;
  }
  .tape3d__left {
    transform: rotateY(-90deg) translateZ(calc(var(--w) / 2));
  }
  .tape3d__right {
    transform: rotateY(90deg) translateZ(calc(var(--w) / 2));
  }
  .tape3d__label {
    padding: 4% 6%;
    border-radius: 4px;
    background: linear-gradient(180deg, #efe4d0, #dccbb0);
    color: #2a2622;
  }
  .tape3d__label span {
    display: block;
    font-family: var(--mp-font-serif);
    font-style: italic;
    font-size: clamp(0.9rem, 1.6vw, 1.35rem);
  }
  .tape3d__label small {
    font-size: clamp(0.55rem, 0.9vw, 0.72rem);
    letter-spacing: 0.08em;
    color: #6f665b;
  }
  .tape3d__window {
    flex: 1;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border-radius: 6px;
    background: #0b0908;
    box-shadow: inset 0 2px 12px rgba(0, 0, 0, 0.8);
  }
  .tape3d__reel {
    width: 26%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, #0b0908 18%, transparent 19%),
      repeating-conic-gradient(#3a332c 0 30deg, #2a241f 30deg 60deg);
    box-shadow: 0 0 0 6px #4a3f33;
  }
  .stage__noise {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.35;
    mix-blend-mode: screen;
    background-image: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 3px);
  }
  .stage__glow {
    position: absolute;
    inset: 15%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 176, 122, 0.45), transparent 65%);
    opacity: 0;
    filter: blur(30px);
    pointer-events: none;
  }
  .stage__status {
    position: absolute;
    left: 1.5rem;
    bottom: 1.3rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mp-night-muted);
  }
  .stage__status span::before {
    content: "●";
    margin-right: 0.5rem;
    color: #c0503f;
  }
  .stage.is-restored .stage__status span::before {
    color: #6fae7c;
  }

  @media (max-width: 900px) {
    .problem__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .problem__pin {
      padding-block: 5rem;
    }
    .stage {
      max-width: 520px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
