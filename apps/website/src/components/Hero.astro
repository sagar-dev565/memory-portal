---
// Hero: full-screen Three.js "memory tunnel" (see scripts/memory-scene.ts)
// with the headline layered on top. Scroll flies the camera through memories.
---

<section class="hero" id="top" data-hero>
  <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="hero__vignette" aria-hidden="true"></div>

  <div class="hero__content" data-hero-content>
    <p class="eyebrow hero__eyebrow" data-hero-fade>Family memory preservation studio</p>
    <h1 class="display hero__title" data-split-hero>
      Your memories deserve more than a <em>box in the attic.</em>
    </h1>
    <div class="hero__bottom">
      <p class="lead" data-hero-fade>
        We digitize VHS tapes, DVDs, photos, film reels and cassettes by hand — then bring
        them together in a private family portal where your story lives on.
      </p>
      <div class="hero__ctas" data-hero-fade>
        <a href="#pricing" class="btn btn--gold" data-hover data-magnetic>
          Preserve My Memories <span class="btn__arrow">→</span>
        </a>
        <a href="#how-it-works" class="btn btn--ghost" data-hover data-magnetic>See How It Works</a>
      </div>
    </div>
  </div>

  <div class="hero__meta" data-hero-fade>
    <span>VHS · DVD · Film · Photos · Audio</span>
    <span class="hero__scroll"><i></i>Scroll to travel through time</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: radial-gradient(120% 90% at 50% 40%, #1d1813 0%, var(--mp-night) 70%);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(14, 12, 10, 0.55) 0%, transparent 30%, transparent 55%, rgba(14, 12, 10, 0.92) 100%),
      radial-gradient(70% 60% at 50% 50%, transparent 40%, rgba(14, 12, 10, 0.7) 100%);
  }
  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    width: min(100% - 3rem, 1320px);
    margin-inline: auto;
    padding-bottom: clamp(6rem, 12vh, 9rem);
  }
  .hero__eyebrow {
    margin-bottom: 1.5rem;
  }
  .hero__title {
    max-width: 13ch;
    text-shadow: 0 10px 60px rgba(0, 0, 0, 0.5);
  }
  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
  }
  .hero__ctas {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .hero__meta {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1.6rem;
    transform: translateX(-50%);
    width: min(100% - 3rem, 1320px);
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mp-night-muted);
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .hero__scroll i {
    position: relative;
    width: 1px;
    height: 28px;
    background: var(--mp-night-line);
    overflow: hidden;
  }
  .hero__scroll i::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--mp-gold-glow);
    animation: scrollLine 1.8s var(--mp-ease-out) infinite;
  }
  @keyframes scrollLine {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }
  @media (max-width: 640px) {
    .hero__vignette {
      background:
        linear-gradient(180deg, rgba(14, 12, 10, 0.5) 0%, rgba(14, 12, 10, 0.15) 22%, rgba(14, 12, 10, 0.82) 48%, rgba(14, 12, 10, 0.97) 100%);
    }
    .hero__meta span:first-child {
      display: none;
    }
    .hero__meta {
      justify-content: center;
    }
    .hero__ctas {
      width: 100%;
    }
    .hero__ctas .btn {
      flex: 1 1 auto;
    }
  }
</style>
