---
import Icon from "./Icon.astro";
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="eyebrow">Family memory preservation</span>
      <h1>Your memories deserve more than a box in the attic.</h1>
      <p class="hero__lead">
        We carefully digitize your VHS tapes, DVDs, photos, film reels and cassettes — then
        bring them together in a private family portal where your story lives on.
      </p>
      <div class="hero__ctas">
        <a href="#pricing" class="btn btn--primary">Preserve My Memories</a>
        <a href="#how-it-works" class="btn btn--secondary">See How It Works</a>
      </div>
      <ul class="hero__assurances">
        <li><Icon name="shield" size={18} /> Private &amp; secure</li>
        <li><Icon name="check" size={18} /> Originals returned</li>
        <li><Icon name="heart" size={18} /> Handled with care</li>
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="polaroid polaroid--1">
        <div class="photo tone-a"></div>
        <span>Wedding · 1985</span>
      </div>
      <div class="polaroid polaroid--2">
        <div class="photo tone-c"></div>
        <span>Goa trip · 2002</span>
      </div>

      <div class="portal-card">
        <div class="portal-card__cover photo tone-b">
          <span class="portal-card__family">The Sharma Family</span>
        </div>
        <div class="portal-card__body">
          <p class="portal-card__label">Now playing</p>
          <p class="portal-card__title">Dad &amp; Mom's Wedding</p>
          <div class="portal-card__progress"><span></span></div>
          <div class="portal-card__meta">
            <span><Icon name="play" size={14} /> Resume at 1:24:08</span>
            <span>Chapter 3 of 9</span>
          </div>
        </div>
      </div>

      <div class="tape">
        <Icon name="vhs" size={22} />
        <span>VHS · 8 hrs captured</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(90% 70% at 85% 10%, var(--mp-ivory-deep), transparent 60%),
      var(--mp-ivory);
    padding-block: var(--mp-space-9) var(--mp-space-10);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--mp-space-8);
    align-items: center;
  }
  .hero h1 {
    font-size: var(--mp-text-display);
    margin-top: var(--mp-space-4);
  }
  .hero__lead {
    margin-top: var(--mp-space-5);
    font-size: var(--mp-text-lg);
    color: var(--mp-charcoal-soft);
    max-width: 540px;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mp-space-3);
    margin-top: var(--mp-space-6);
  }
  .hero__assurances {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mp-space-5);
    margin: var(--mp-space-6) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--mp-text-sm);
    color: var(--mp-muted);
  }
  .hero__assurances li {
    display: flex;
    align-items: center;
    gap: var(--mp-space-2);
  }
  .hero__assurances :global(svg) {
    color: var(--mp-gold);
  }

  /* Visual collage */
  .hero__visual {
    position: relative;
    min-height: 600px;
  }
  .polaroid {
    position: absolute;
    width: 200px;
    padding: 12px 12px 16px;
    background: var(--mp-warm-white);
    border-radius: 6px;
    box-shadow: var(--mp-shadow-lg);
  }
  .polaroid .photo {
    aspect-ratio: 1 / 1;
    border-radius: 3px;
  }
  .polaroid span {
    display: block;
    margin-top: 10px;
    font-family: var(--mp-font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--mp-charcoal-soft);
    text-align: center;
  }
  .polaroid--1 {
    top: 0;
    left: 2%;
    transform: rotate(-7deg);
  }
  .polaroid--2 {
    top: 30px;
    right: 0;
    transform: rotate(6deg);
  }
  .portal-card {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(400px, 92%);
    transform: translateX(-50%);
    background: var(--mp-warm-white);
    border-radius: var(--mp-radius-lg);
    box-shadow: var(--mp-shadow-lg);
    overflow: hidden;
    border: 1px solid var(--mp-line);
  }
  .portal-card__cover {
    height: 150px;
    display: flex;
    align-items: flex-end;
    padding: var(--mp-space-4);
  }
  .portal-card__family {
    position: relative;
    z-index: 1;
    font-family: var(--mp-font-serif);
    font-size: 1.5rem;
    color: var(--mp-warm-white);
    text-shadow: 0 1px 12px rgba(42, 38, 34, 0.35);
  }
  .portal-card__body {
    padding: var(--mp-space-4) var(--mp-space-5) var(--mp-space-5);
  }
  .portal-card__label {
    font-size: var(--mp-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mp-gold-deep);
    font-weight: 600;
  }
  .portal-card__title {
    font-family: var(--mp-font-serif);
    font-size: 1.25rem;
    margin-top: 2px;
  }
  .portal-card__progress {
    height: 5px;
    border-radius: 99px;
    background: var(--mp-beige-soft);
    margin-top: var(--mp-space-3);
    overflow: hidden;
  }
  .portal-card__progress span {
    display: block;
    width: 38%;
    height: 100%;
    background: var(--mp-gold);
  }
  .portal-card__meta {
    display: flex;
    justify-content: space-between;
    margin-top: var(--mp-space-2);
    font-size: var(--mp-text-xs);
    color: var(--mp-muted);
  }
  .portal-card__meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .tape {
    position: absolute;
    top: 52%;
    left: -2%;
    display: flex;
    align-items: center;
    gap: var(--mp-space-2);
    padding: 10px 16px;
    background: var(--mp-charcoal);
    color: var(--mp-ivory);
    border-radius: var(--mp-radius-pill);
    font-size: var(--mp-text-xs);
    font-weight: 600;
    box-shadow: var(--mp-shadow-md);
  }
  .tape :global(svg) {
    color: var(--mp-gold-soft);
  }

  @media (max-width: 960px) {
    .hero {
      padding-block: var(--mp-space-7) var(--mp-space-8);
    }
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      min-height: 560px;
      max-width: 520px;
      width: 100%;
      margin-inline: auto;
    }
  }
  @media (max-width: 480px) {
    .polaroid {
      width: 160px;
    }
    .hero__visual {
      min-height: 480px;
    }
    .tape {
      display: none;
    }
  }
</style>
