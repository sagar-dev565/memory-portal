---
import Icon from "./Icon.astro";
import { timeline } from "../data/site";
---

<section class="section portal" id="portal" data-portal>
  <div class="container">
    <div class="portal__head">
      <p class="eyebrow">Your Memory Portal</p>
      <h2 class="title" data-split>Not cloud storage. Your family's story, <em>in order.</em></h2>
      <p class="lead">
        Every memory finds its place on your Family Timeline — with the people in it.
        Find a 20-year-old wedding video in seconds.
      </p>
    </div>

    <div class="portal__stage">
      <div class="frame" data-portal-frame>
        <div class="frame__bar" aria-hidden="true"><span></span><span></span><span></span><b>memoryportal.app / sharma-family</b></div>
        <div class="frame__body">
          <aside class="frame__side" aria-hidden="true">
            <b>The Sharma Family</b>
            <span class="is-active">Timeline</span>
            <span>Events</span>
            <span>Photos</span>
            <span>Videos</span>
            <span>People</span>
            <span>Family Members</span>
          </aside>
          <div class="frame__main">
            <p class="frame__hello">Our family story lives here.</p>
            <p class="frame__sub">On this day, 1998 — Dad &amp; Mom's wedding reception</p>
            <ol class="tl">
              {timeline.map((t) => (
                <li class="tl__item" data-tl-item>
                  <span class="tl__year">{t.year}</span>
                  <div class="tl__card">
                    <span class:list={["tl__photo", `tone-${t.tone}`]}></span>
                    <div>
                      <b>{t.title}</b>
                      <small>{t.meta}</small>
                    </div>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
      <div class="portal__glow" aria-hidden="true"></div>
    </div>

    <ul class="features">
      <li data-reveal><Icon name="play" size={22} /><div><b>Long videos, made easy</b><span>Chapters, resume playback and speed control — even for 8-hour tapes.</span></div></li>
      <li data-reveal><Icon name="users" size={22} /><div><b>Share with family</b><span>Invite family and choose who can view, upload, download or share.</span></div></li>
      <li data-reveal><Icon name="heart" size={22} /><div><b>People &amp; events</b><span>Browse by Grandpa, Mom, birthdays or trips — not file names.</span></div></li>
    </ul>
  </div>
</section>

<style>
  .portal {
    background: linear-gradient(180deg, var(--mp-night) 0%, var(--mp-night-2) 100%);
    overflow: hidden;
  }
  .portal__head {
    text-align: center;
    max-width: 860px;
    margin-inline: auto;
  }
  .portal__head .eyebrow::before {
    display: none;
  }
  .portal__head h2 {
    margin: 1rem 0 1.5rem;
  }
  .portal__head .lead {
    margin-inline: auto;
  }
  .portal__stage {
    position: relative;
    margin-top: 4.5rem;
    perspective: 1600px;
  }
  .portal__glow {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -10%;
    height: 50%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(212, 176, 122, 0.35), transparent 70%);
    filter: blur(40px);
    z-index: 0;
  }
  .frame {
    position: relative;
    z-index: 1;
    background: #fbf7f0;
    color: var(--mp-charcoal);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 60px 120px -40px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.08);
    transform-origin: 50% 0%;
  }
  .frame__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    background: #efe6d6;
  }
  .frame__bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d9cbb3;
  }
  .frame__bar b {
    margin-left: auto;
    margin-right: auto;
    font-weight: 500;
    font-size: 0.72rem;
    color: #8a7f70;
    padding: 4px 14px;
    border-radius: 999px;
    background: #f7f1e6;
  }
  .frame__body {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 420px;
  }
  .frame__side {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 1.5rem 1rem;
    border-right: 1px solid #e2d7c5;
    background: #f7f1e6;
    font-size: 0.9rem;
    color: #4a443d;
  }
  .frame__side b {
    font-family: var(--mp-font-serif);
    font-weight: 400;
    font-size: 1.15rem;
    color: #2a2622;
    margin-bottom: 0.8rem;
  }
  .frame__side span {
    padding: 8px 12px;
    border-radius: 8px;
  }
  .frame__side .is-active {
    background: #fff;
    font-weight: 600;
    color: #2a2622;
    box-shadow: 0 1px 2px rgba(42, 38, 34, 0.08);
  }
  .frame__main {
    padding: 2rem;
  }
  .frame__hello {
    font-family: var(--mp-font-serif);
    font-size: clamp(1.6rem, 1rem + 1.6vw, 2.4rem);
    line-height: 1.1;
  }
  .frame__sub {
    margin-top: 0.4rem;
    color: #6f665b;
    font-size: 0.9rem;
  }
  .tl {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.9rem;
    margin: 2rem 0 0;
    padding: 1.5rem 0 0;
    list-style: none;
    border-top: 2px solid #e6d9c3;
  }
  .tl__year {
    display: block;
    font-family: var(--mp-font-serif);
    font-size: 1.45rem;
    color: #8a6a3c;
    margin-bottom: 0.5rem;
  }
  .tl__card {
    border: 1px solid #e2d7c5;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }
  .tl__photo {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .tl__card div {
    padding: 10px 12px;
  }
  .tl__card b {
    display: block;
    font-size: 0.88rem;
  }
  .tl__card small {
    color: #6f665b;
    font-size: 0.75rem;
  }
  .tone-a { background: linear-gradient(160deg, #d9c3a1, #a98762); }
  .tone-b { background: linear-gradient(160deg, #e3d1b8, #b99a7b); }
  .tone-c { background: linear-gradient(160deg, #c9b79c, #8f7a5e); }
  .tone-d { background: linear-gradient(160deg, #e6d6c0, #c2a27c); }
  .tone-e { background: linear-gradient(160deg, #efe3cf, #d2b892); }
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin: 5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    display: flex;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--mp-night-line);
  }
  .features :global(svg) {
    color: var(--mp-gold-glow);
    flex: none;
    margin-top: 3px;
  }
  .features b {
    display: block;
    font-weight: 500;
  }
  .features span {
    font-size: 0.92rem;
    color: var(--mp-night-muted);
  }
  @media (max-width: 960px) {
    .frame__body {
      grid-template-columns: 1fr;
    }
    .frame__side {
      display: none;
    }
    .tl {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    }
    .features {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .frame__main {
      padding: 1.2rem;
    }
    .tl {
      grid-template-columns: repeat(2, 1fr);
    }
    .tl__item:last-child {
      display: none;
    }
  }
</style>
