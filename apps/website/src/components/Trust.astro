---
import Icon from "./Icon.astro";
import { trustPoints } from "../data/site";
const icons = ["lock", "check", "shield", "users"] as const;
---

<section class="section trust" id="trust">
  <div class="container">
    <div class="trust__head">
      <p class="eyebrow">Trust &amp; privacy</p>
      <h2 class="title" data-split>Irreplaceable memories deserve <em>real care.</em></h2>
    </div>
    <div class="trust__grid">
      {trustPoints.map((t, i) => (
        <div class="trust__item" data-reveal>
          <span class="trust__icon"><Icon name={icons[i]} size={24} /></span>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--mp-night-2);
  }
  .trust__head h2 {
    margin-top: 1rem;
    max-width: 16ch;
  }
  .trust__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-top: 4rem;
  }
  .trust__item {
    padding: 2rem 1.6rem;
    border-radius: 22px;
    border: 1px solid var(--mp-night-line);
    background: linear-gradient(170deg, var(--mp-night-3), transparent);
  }
  .trust__icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 1px solid rgba(212, 176, 122, 0.35);
    color: var(--mp-gold-glow);
  }
  .trust__item h3 {
    margin-top: 2rem;
    font-size: 1.45rem;
  }
  .trust__item p {
    margin-top: 0.7rem;
    font-size: 0.92rem;
    color: var(--mp-night-muted);
  }
  @media (max-width: 960px) {
    .trust__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .trust__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
