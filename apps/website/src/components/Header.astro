---
import { nav } from "../data/site";
---

<header class="header" data-header>
  <div class="header__inner">
    <a href="#top" class="brand" aria-label="Memory Portal home" data-hover>
      <svg viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
        <path d="M18 48V26a14 14 0 0 1 28 0v22" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
        <circle cx="32" cy="36" r="4" fill="#d4b07a" />
      </svg>
      <span>Memory Portal</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((item, i) => (
          <li>
            <a href={item.href} data-hover>
              <span class="nav__num">0{i + 1}</span>{item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="#pricing" class="btn btn--ghost header__cta" data-hover data-magnetic>Get Started</a>

    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" data-burger>
      <span></span><span></span>
    </button>
  </div>

  <div class="menu" data-menu>
    <nav aria-label="Mobile">
      {nav.map((item, i) => (
        <a href={item.href} data-menu-link><span>0{i + 1}</span>{item.label}</a>
      ))}
      <a href="#pricing" data-menu-link><span>→</span>Get Started</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    transition: transform 0.6s var(--mp-ease-out), background 0.4s;
  }
  .header.is-hidden {
    transform: translateY(-100%);
  }
  .header.is-scrolled {
    background: rgba(14, 12, 10, 0.72);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--mp-night-line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: min(100% - 3rem, 1320px);
    margin-inline: auto;
    min-height: 84px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font-family: var(--mp-font-serif);
    font-size: 1.3rem;
    color: var(--mp-night-text);
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 1.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    position: relative;
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--mp-night-muted);
    transition: color 0.3s;
  }
  .nav a:hover {
    color: var(--mp-night-text);
  }
  .nav__num {
    font-size: 0.65rem;
    color: var(--mp-gold-glow);
    margin-right: 0.35rem;
    vertical-align: super;
  }
  .header__cta {
    min-height: 44px;
    padding: 0 1.4rem;
    font-size: 0.85rem;
  }
  .burger {
    display: none;
    margin-left: auto;
    width: 48px;
    height: 48px;
    border: 1px solid var(--mp-night-line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .burger span {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: var(--mp-night-text);
    transition: transform 0.5s var(--mp-ease-out), top 0.5s var(--mp-ease-out);
  }
  .burger span:first-child { top: 19px; }
  .burger span:last-child { top: 27px; }
  .header.is-open .burger span:first-child { top: 23px; transform: rotate(45deg); }
  .header.is-open .burger span:last-child { top: 23px; transform: rotate(-45deg); }

  .menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    align-items: center;
    padding: 6rem 1.5rem 2rem;
    background: var(--mp-night);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--mp-ease-out);
  }
  .header.is-open .menu {
    clip-path: inset(0 0 0 0);
  }
  .menu nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
  }
  .menu a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--mp-night-line);
    font-family: var(--mp-font-serif);
    font-size: clamp(2rem, 9vw, 3rem);
    text-decoration: none;
  }
  .menu a span {
    font-family: var(--mp-font-sans);
    font-size: 0.75rem;
    color: var(--mp-gold-glow);
  }

  @media (max-width: 1080px) {
    .nav,
    .header__cta {
      display: none;
    }
    .burger {
      display: block;
    }
  }
</style>
