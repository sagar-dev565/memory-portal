---
import { nav } from "../data/site";
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label="Memory Portal home">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="34" height="34">
          <rect width="64" height="64" rx="16" fill="#2a2622" />
          <path d="M20 44V24a12 12 0 0 1 24 0v20" fill="none" stroke="#e9dcc4" stroke-width="4" stroke-linecap="round" />
          <circle cx="32" cy="34" r="4" fill="#a8834f" />
        </svg>
      </span>
      <span class="brand__name">Memory Portal</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__actions">
      <a href="#login" class="header__login">Log in</a>
      <a href="#pricing" class="btn btn--primary btn--sm">Get Started</a>
    </div>

    <details class="mobile-nav">
      <summary aria-label="Open menu">
        <span></span><span></span><span></span>
      </summary>
      <div class="mobile-nav__panel">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="#login">Log in</a>
        <a href="#pricing" class="btn btn--primary">Get Started</a>
      </div>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(253, 251, 247, 0.92);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--mp-line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--mp-space-6);
    min-height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--mp-space-3);
    text-decoration: none;
  }
  .brand__name {
    font-family: var(--mp-font-serif);
    font-size: 1.3rem;
    font-weight: 500;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: var(--mp-space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a,
  .header__login {
    font-size: var(--mp-text-sm);
    font-weight: 500;
    color: var(--mp-charcoal-soft);
    text-decoration: none;
  }
  .nav a:hover,
  .header__login:hover {
    color: var(--mp-gold-deep);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--mp-space-5);
  }
  .mobile-nav {
    display: none;
  }

  @media (max-width: 1024px) {
    .nav,
    .header__actions {
      display: none;
    }
    .mobile-nav {
      display: block;
      margin-left: auto;
      position: relative;
    }
    .mobile-nav summary {
      list-style: none;
      width: var(--mp-touch-target);
      height: var(--mp-touch-target);
      display: grid;
      place-content: center;
      gap: 5px;
      cursor: pointer;
    }
    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }
    .mobile-nav summary span {
      width: 22px;
      height: 2px;
      background: var(--mp-charcoal);
      border-radius: 2px;
    }
    .mobile-nav__panel {
      position: absolute;
      right: 0;
      top: calc(100% + 8px);
      width: min(86vw, 320px);
      display: flex;
      flex-direction: column;
      gap: var(--mp-space-1);
      padding: var(--mp-space-4);
      background: var(--mp-warm-white);
      border: 1px solid var(--mp-line);
      border-radius: var(--mp-radius-lg);
      box-shadow: var(--mp-shadow-lg);
    }
    .mobile-nav__panel a:not(.btn) {
      padding: var(--mp-space-3) var(--mp-space-2);
      text-decoration: none;
      font-weight: 500;
      border-bottom: 1px solid var(--mp-beige-soft);
    }
    .mobile-nav__panel .btn {
      margin-top: var(--mp-space-3);
    }
  }
</style>
