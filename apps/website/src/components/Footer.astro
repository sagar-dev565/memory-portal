---
const year = new Date().getFullYear();
const columns = [
  { title: "Services", links: ["VHS & Tapes", "DVDs & CDs", "Photos & Albums", "Film Reels", "Audio Cassettes"] },
  { title: "Product", links: ["Family Portal", "Memory Key", "Keepsakes", "Pricing", "Examples"] },
  { title: "Company", links: ["About", "For Studios", "FAQ", "Contact", "Privacy"] },
];
---

<section class="cta" id="contact" data-cta>
  <div class="container cta__inner">
    <p class="eyebrow">Start today</p>
    <h2 class="cta__title" data-cta-title>Our family story <em>lives here.</em></h2>
    <p class="lead cta__lead">Start preserving today — before another year turns another tape to static.</p>
    <div class="cta__buttons">
      <a href="#pricing" class="btn btn--gold" data-hover data-magnetic>Preserve My Memories <span class="btn__arrow">→</span></a>
      <a href="mailto:hello@memoryportal.example" class="btn btn--ghost" data-hover data-magnetic>hello@memoryportal.example</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <p>Your memories deserve more than a box in the attic.</p>
      </div>
      {columns.map((c) => (
        <nav aria-label={c.title}>
          <p class="footer__title">{c.title}</p>
          <ul>{c.links.map((l) => <li><a href="#" data-hover>{l}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <p class="footer__word" aria-hidden="true" data-footer-word>Memory Portal</p>
    <div class="footer__bottom">
      <p>© {year} Memory Portal. All rights reserved.</p>
      <p>Made with care for families everywhere.</p>
    </div>
  </div>
</footer>

<style>
  .cta {
    position: relative;
    padding-block: clamp(7rem, 14vw, 12rem);
    background: radial-gradient(70% 70% at 50% 100%, rgba(212, 176, 122, 0.18), transparent 70%), var(--mp-night);
    text-align: center;
    overflow: hidden;
  }
  .cta .eyebrow::before {
    display: none;
  }
  .cta__title {
    margin-top: 1.5rem;
    font-size: clamp(3rem, 1.5rem + 7vw, 9rem);
  }
  .cta__lead {
    margin: 2rem auto 0;
  }
  .cta__buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.5rem;
  }
  .footer {
    padding-block: 5rem 2rem;
    background: #090807;
    color: var(--mp-night-muted);
    font-size: 0.9rem;
    overflow: hidden;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 2rem;
  }
  .footer__brand p {
    max-width: 260px;
    font-family: var(--mp-font-serif);
    font-size: 1.3rem;
    line-height: 1.3;
    color: var(--mp-night-text);
  }
  .footer__title {
    color: var(--mp-night-text);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .footer ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer a {
    text-decoration: none;
    transition: color 0.3s;
  }
  .footer a:hover {
    color: var(--mp-gold-glow);
  }
  .footer__word {
    margin-top: 4rem;
    font-family: var(--mp-font-serif);
    font-size: clamp(3.5rem, 1rem + 12.5vw, 15rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(243, 236, 224, 0.18);
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--mp-night-line);
    font-size: 0.78rem;
  }
  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
