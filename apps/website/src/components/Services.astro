---
import Icon from "./Icon.astro";
import { conversionServices, deliveryServices } from "../data/site";

const all = [
  ...conversionServices.map((s) => ({ ...s, group: "We preserve" })),
  ...deliveryServices.map((s) => ({ ...s, group: "You receive" })),
];
---

<section class="services" id="services" data-services>
  <div class="services__pin" data-services-pin>
    <div class="services__head container">
      <div>
        <p class="eyebrow">Our services</p>
        <h2 class="title" data-split>Everything your family needs to <em>preserve its story.</em></h2>
      </div>
      <p class="lead">
        Two simple parts: we convert your old media by hand, then give it back as something your
        family will treasure. Scroll to explore.
      </p>
    </div>

    <div class="services__viewport">
      <div class="services__track" data-services-track>
        {all.map((s, i) => (
          <article class:list={["svc", s.group === "You receive" && "svc--receive"]} data-tilt data-hover>
            <div class="svc__top">
              <span class="svc__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="svc__group">{s.group}</span>
            </div>
            <span class="svc__icon"><Icon name={s.icon} size={34} /></span>
            <h3>{s.title}</h3>
            <p class="svc__summary">{s.summary}</p>
            <ul>
              {s.includes.map((x) => <li>{x}</li>)}
            </ul>
            {s.tag && <span class="svc__tag">{s.tag}</span>}
          </article>
        ))}
      </div>
    </div>

    <div class="services__progress container" aria-hidden="true">
      <span class="services__bar"><i data-services-bar></i></span>
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    background: var(--mp-night-2);
  }
  .services__pin {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 7rem 4rem;
    overflow: hidden;
  }
  .services__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 3rem;
    flex-wrap: wrap;
  }
  .services__head h2 {
    max-width: 14ch;
    margin-top: 1rem;
  }
  .services__viewport {
    margin-top: 3.5rem;
  }
  .services__track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    padding-inline: max(1.5rem, calc((100vw - 1320px) / 2));
  }
  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    width: clamp(280px, 26vw, 360px);
    min-height: 440px;
    padding: 1.8rem;
    border-radius: 24px;
    background: linear-gradient(170deg, var(--mp-night-3), #12100d);
    border: 1px solid var(--mp-night-line);
    transform-style: preserve-3d;
    will-change: transform;
    transition: border-color 0.4s;
  }
  .svc:hover {
    border-color: rgba(212, 176, 122, 0.45);
  }
  .svc--receive {
    background: linear-gradient(170deg, #2a2219, #16120e);
  }
  .svc__top {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mp-night-muted);
  }
  .svc__num {
    color: var(--mp-gold-glow);
  }
  .svc__icon {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    margin-top: 2.2rem;
    border-radius: 20px;
    background: rgba(212, 176, 122, 0.1);
    color: var(--mp-gold-glow);
    transform: translateZ(40px);
  }
  .svc h3 {
    margin-top: 1.6rem;
    font-size: 1.85rem;
    transform: translateZ(30px);
  }
  .svc__summary {
    margin-top: 0.8rem;
    font-size: 0.95rem;
    color: var(--mp-night-muted);
  }
  .svc ul {
    margin: auto 0 0;
    padding: 1.4rem 0 0;
    list-style: none;
    border-top: 1px solid var(--mp-night-line);
    display: grid;
    gap: 0.45rem;
    font-size: 0.85rem;
  }
  .svc li::before {
    content: "—";
    margin-right: 0.6rem;
    color: var(--mp-gold-glow);
  }
  .svc__tag {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    transform: translateY(1.7rem);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--mp-gold-glow);
    color: var(--mp-night);
    font-size: 0.7rem;
    font-weight: 600;
  }
  .services__progress {
    margin-top: 2.5rem;
  }
  .services__bar {
    display: block;
    height: 1px;
    background: var(--mp-night-line);
  }
  .services__bar i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--mp-gold-glow);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Mobile & reduced motion: native horizontal swipe instead of pinning */
  @media (max-width: 900px) {
    .services__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .svc {
      scroll-snap-align: center;
      width: 82vw;
      min-height: 420px;
    }
    .services__progress {
      display: none;
    }
  }
</style>
