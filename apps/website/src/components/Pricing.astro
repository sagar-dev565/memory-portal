---
import Icon from "./Icon.astro";
import { plans } from "../data/site";
---

<section class="section pricing" id="pricing">
  <div class="container">
    <div class="pricing__head">
      <p class="eyebrow">Pricing</p>
      <h2 class="title" data-split>Simple plans for every <em>family collection.</em></h2>
      <p class="lead">Every plan includes careful digitization, your originals returned, and a private family portal.</p>
    </div>

    <div class="plans" data-plans>
      {plans.map((p) => (
        <article class:list={["plan", p.featured && "plan--featured"]} data-plan data-tilt data-hover>
          {p.featured && <span class="plan__badge">Most popular</span>}
          <h3>{p.name}</h3>
          <p class="plan__desc">{p.description}</p>
          <p class="plan__price">{p.price}</p>
          <p class="plan__cadence">{p.cadence}</p>
          <ul>
            {p.features.map((f) => <li><Icon name="check" size={18} />{f}</li>)}
          </ul>
          <a href="#contact" class:list={["btn", p.featured ? "btn--gold" : "btn--ghost"]} data-hover>{p.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--mp-night);
  }
  .pricing__head {
    text-align: center;
    max-width: 820px;
    margin-inline: auto;
  }
  .pricing__head .eyebrow::before {
    display: none;
  }
  .pricing__head h2 {
    margin: 1rem 0 1.5rem;
  }
  .pricing__head .lead {
    margin-inline: auto;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-top: 4.5rem;
    perspective: 1200px;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.2rem;
    border-radius: 28px;
    border: 1px solid var(--mp-night-line);
    background: var(--mp-night-2);
    transform-style: preserve-3d;
  }
  .plan--featured {
    background: linear-gradient(165deg, #3a2f23, #1c1712 70%);
    border-color: rgba(212, 176, 122, 0.5);
    box-shadow: 0 40px 80px -40px rgba(212, 176, 122, 0.35);
  }
  .plan__badge {
    position: absolute;
    top: -13px;
    left: 2.2rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--mp-gold-glow);
    color: var(--mp-night);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .plan h3 {
    font-size: 1.7rem;
  }
  .plan__desc {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    color: var(--mp-night-muted);
    min-height: 3em;
  }
  .plan__price {
    margin-top: 2rem;
    font-family: var(--mp-font-serif);
    font-size: clamp(2.8rem, 2rem + 2vw, 4rem);
    line-height: 1;
    color: var(--mp-night-text);
  }
  .plan--featured .plan__price {
    color: var(--mp-gold-glow);
  }
  .plan__cadence {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--mp-night-muted);
  }
  .plan ul {
    display: grid;
    gap: 0.8rem;
    margin: 1.8rem 0 2.2rem;
    padding: 1.8rem 0 0;
    list-style: none;
    border-top: 1px solid var(--mp-night-line);
    font-size: 0.92rem;
  }
  .plan li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .plan li :global(svg) {
    color: var(--mp-gold-glow);
    flex: none;
    margin-top: 2px;
  }
  .plan .btn {
    margin-top: auto;
  }
  @media (max-width: 960px) {
    .plans {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-inline: auto;
    }
  }
</style>
